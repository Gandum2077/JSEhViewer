{
  "name": "jsehviewer",
  "version": "3.10.0",
  "description": "",
  "homepage": "https://github.com/Gandum2077/JSEhViewer",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gandum2077/JSEhViewer.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && webpack --entry-reset --entry ${npm_config_entry:-./dist/index.js} && cd app && zip -q -r ../JSEhViewer.box . && rm main.js",
    "bump": "npm version --no-git-tag-version",
    "check:version": "node scripts/sync-version.js --check",
    "format": "prettier --write .",
    "test:database-init": "tsc && node scripts/check-database-initialization.js",
    "test:database-migration-v2": "tsc && node scripts/check-database-migration-v2-draft.js",
    "test:database-schema-v2": "tsc && node scripts/check-database-schema-v2-draft.js",
    "test:archive-repository": "tsc && node scripts/check-archive-repository.js",
    "test:archive-repository-v2": "tsc && node scripts/check-archive-repository-v2.js",
    "test:marked-tag-repository": "tsc && node scripts/check-marked-tag-repository.js",
    "test:marked-tag-repository-v2": "tsc && node scripts/check-marked-tag-repository-v2.js",
    "test:search-repository": "tsc && node scripts/check-search-repository.js",
    "test:search-history-repository-v2": "tsc && node scripts/check-search-history-repository-v2.js",
    "test:search-bookmark-repository-v2": "tsc && node scripts/check-search-bookmark-repository-v2.js",
    "test:sync-mutation-writer": "tsc && node scripts/check-sync-mutation-writer.js",
    "test:uploader-repository": "tsc && node scripts/check-uploader-repository.js",
    "test:uploader-repository-v2": "tsc && node scripts/check-uploader-repository-v2.js",
    "test:sqlite-safe": "tsc && node scripts/check-sqlite-safe.js",
    "version": "node scripts/sync-version.js"
  },
  "keywords": [],
  "author": "Gandum2077",
  "license": "MIT",
  "dependencies": {
    "cheerio": "0.22.0",
    "ehentai-parser": "^1.15.0",
    "jsbox-cview": "^2.0.0",
    "prettier": "^3.8.1",
    "url-parse": "^1.5.10"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20.11.25",
    "@types/url-parse": "^1.4.11",
    "jsbox-types": "^2.0.1",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4"
  }
}
